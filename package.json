{
  "name": "@irb/content",
  "version": "1.0.0",
  "description": "Conteúdo confessional e litúrgico do App IRB. Markdown é a fonte editorial (fontes/); o JSON validado em content/ é o artefato consumido pelo app. Ver docs/CONVERSOR.md, ADR-021 e SPEC-REPOSITORIO-DE-CONTEUDO.md.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "content",
    "schemas",
    "scripts/lib"
  ],
  "exports": {
    ".": "./scripts/lib/validate-content.mjs",
    "./validate": "./scripts/lib/validate-content.mjs",
    "./check-version-bump": "./scripts/lib/check-version-bump.mjs",
    "./schemas/*": "./schemas/*",
    "./content/*": "./content/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "convert": "node ./scripts/convert.mjs",
    "convert:check": "node ./scripts/convert.mjs --check",
    "validate:content": "node ./scripts/validate-content.mjs",
    "check:version-bump": "node ./scripts/check-version-bump.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
